#!/bin/bash

mkdir -p "$HOME/Pictures/NL-OS"
mkdir -p "$HOME/.config/autostart"

cat > "$HOME/Pictures/NL-OS/nl-premium-wallpaper.svg" <<'SVG'
<svg width="1920" height="1080" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#eaf8ff"/>
      <stop offset="45%" stop-color="#fbfdff"/>
      <stop offset="100%" stop-color="#e8f1f6"/>
    </linearGradient>
    <radialGradient id="blue" cx="20%" cy="18%" r="70%">
      <stop offset="0%" stop-color="#8eddf5" stop-opacity="0.75"/>
      <stop offset="100%" stop-color="#8eddf5" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="gold" cx="82%" cy="75%" r="55%">
      <stop offset="0%" stop-color="#dac18a" stop-opacity="0.45"/>
      <stop offset="100%" stop-color="#dac18a" stop-opacity="0"/>
    </radialGradient>
    <filter id="blur">
      <feGaussianBlur stdDeviation="18"/>
    </filter>
  </defs>
  <rect width="1920" height="1080" fill="url(#bg)"/>
  <rect width="1920" height="1080" fill="url(#blue)"/>
  <rect width="1920" height="1080" fill="url(#gold)"/>
  <path d="M-160 650 C 260 520, 560 760, 970 560 S 1580 430, 2100 610"
        fill="none" stroke="#ffffff" stroke-width="26" stroke-opacity="0.48" filter="url(#blur)"/>
  <path d="M-160 710 C 260 590, 600 830, 1020 630 S 1600 500, 2100 670"
        fill="none" stroke="#80d9ef" stroke-width="16" stroke-opacity="0.35" filter="url(#blur)"/>
  <text x="960" y="555" text-anchor="middle"
        font-family="Arial, Helvetica, sans-serif"
        font-size="120"
        font-weight="800"
        fill="#121a22"
        fill-opacity="0.055">NL OS</text>
</svg>
SVG

KW=$(command -v kwriteconfig6 || command -v kwriteconfig5 || true)

if [ -n "$KW" ]; then
  "$KW" --file kdeglobals --group General --key ColorScheme BreezeLight || true
  "$KW" --file kdeglobals --group KDE --key LookAndFeelPackage org.kde.breezedark || true
  "$KW" --file kwinrc --group Windows --key BorderlessMaximizedWindows true || true
  "$KW" --file kwinrc --group Desktops --key Number 1 || true
  "$KW" --file kwinrc --group Plugins --key blurEnabled true || true
  "$KW" --file kwinrc --group Plugins --key contrastEnabled true || true
fi

if command -v qdbus6 >/dev/null 2>&1; then
  qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
  var allDesktops = desktops();
  for (i=0;i<allDesktops.length;i++) {
    d = allDesktops[i];
    d.wallpaperPlugin = 'org.kde.image';
    d.currentConfigGroup = Array('Wallpaper', 'org.kde.image', 'General');
    d.writeConfig('Image', 'file://$HOME/Pictures/NL-OS/nl-premium-wallpaper.svg');
  }
  " >/dev/null 2>&1 || true
elif command -v qdbus >/dev/null 2>&1; then
  qdbus org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
  var allDesktops = desktops();
  for (i=0;i<allDesktops.length;i++) {
    d = allDesktops[i];
    d.wallpaperPlugin = 'org.kde.image';
    d.currentConfigGroup = Array('Wallpaper', 'org.kde.image', 'General');
    d.writeConfig('Image', 'file://$HOME/Pictures/NL-OS/nl-premium-wallpaper.svg');
  }
  " >/dev/null 2>&1 || true
fi

cat > "$HOME/.local/share/applications/nl-control.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=NL Control
Exec=nl-control
Icon=preferences-system
Terminal=false
Categories=System;
DESKTOP

echo "NL OS Premium design applied."
