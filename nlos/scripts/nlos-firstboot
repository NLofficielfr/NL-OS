#!/bin/bash

HOME_DIR="$HOME"

mkdir -p "$HOME_DIR/Pictures/NLOS"
mkdir -p "$HOME_DIR/.config/autostart"
mkdir -p "$HOME_DIR/.local/share/applications"

cat > "$HOME_DIR/Pictures/NLOS/wallpaper.svg" <<'SVG'
<svg width="1920" height="1080" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#eaf8ff"/>
      <stop offset="45%" stop-color="#fbfdff"/>
      <stop offset="100%" stop-color="#e8f1f7"/>
    </linearGradient>

    <radialGradient id="blue" cx="18%" cy="20%" r="72%">
      <stop offset="0%" stop-color="#76daf6" stop-opacity="0.58"/>
      <stop offset="100%" stop-color="#76daf6" stop-opacity="0"/>
    </radialGradient>

    <radialGradient id="gold" cx="82%" cy="82%" r="45%">
      <stop offset="0%" stop-color="#dbc48d" stop-opacity="0.28"/>
      <stop offset="100%" stop-color="#dbc48d" stop-opacity="0"/>
    </radialGradient>

    <filter id="blur">
      <feGaussianBlur stdDeviation="24"/>
    </filter>
  </defs>

  <rect width="1920" height="1080" fill="url(#bg)"/>
  <rect width="1920" height="1080" fill="url(#blue)"/>
  <rect width="1920" height="1080" fill="url(#gold)"/>

  <path d="M-240 665 C 250 500, 570 790, 1000 570 S 1580 430, 2160 620"
        fill="none" stroke="#ffffff" stroke-width="34" stroke-opacity="0.40" filter="url(#blur)"/>

  <path d="M-240 735 C 280 590, 620 845, 1040 660 S 1600 535, 2160 715"
        fill="none" stroke="#76d8ef" stroke-width="16" stroke-opacity="0.25" filter="url(#blur)"/>

  <text x="960" y="560"
        text-anchor="middle"
        font-family="Arial, Helvetica, sans-serif"
        font-size="150"
        font-weight="900"
        fill="#101820"
        fill-opacity="0.045">NL</text>
</svg>
SVG

KW=$(command -v kwriteconfig6 || command -v kwriteconfig5 || true)

if [ -n "$KW" ]; then
  "$KW" --file kdeglobals --group General --key ColorScheme BreezeLight || true
  "$KW" --file kwinrc --group Plugins --key blurEnabled true || true
  "$KW" --file kwinrc --group Plugins --key contrastEnabled true || true
  "$KW" --file kwinrc --group Plugins --key translucencyEnabled true || true
  "$KW" --file kwinrc --group Compositing --key Enabled true || true
  "$KW" --file kwinrc --group Compositing --key Backend OpenGL || true
  "$KW" --file kwinrc --group Windows --key BorderlessMaximizedWindows true || true
fi

# Fond KDE
if command -v qdbus6 >/dev/null 2>&1; then
  qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
  var allDesktops = desktops();
  for (i = 0; i < allDesktops.length; i++) {
    d = allDesktops[i];
    d.wallpaperPlugin = 'org.kde.image';
    d.currentConfigGroup = Array('Wallpaper', 'org.kde.image', 'General');
    d.writeConfig('Image', 'file://$HOME_DIR/Pictures/NLOS/wallpaper.svg');
  }
  " >/dev/null 2>&1 || true
fi

rm -f "$HOME_DIR/Desktop/Install"*.desktop 2>/dev/null || true
rm -f "$HOME_DIR/Desktop/Debian"*.desktop 2>/dev/null || true
rm -f "$HOME_DIR/Desktop/calamares"*.desktop 2>/dev/null || true

hostnamectl set-hostname nlos 2>/dev/null || true

echo "NLOS first boot visual setup done."
